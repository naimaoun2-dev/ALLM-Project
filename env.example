# Environment Configuration
# Copy this file to .env and fill in your actual values

# API Keys (if needed for future features)
API_KEY=your_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dbname
DATABASE_USER=user
DATABASE_PASSWORD=password

# Application Settings
APP_ENV=development
DEBUG=true
PORT=3000
HOST=localhost

# LLM/AI Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash

# Embedding Configuration
# Set USE_LOCAL_EMBEDDINGS=true to use free local embeddings (recommended)
# Set USE_LOCAL_EMBEDDINGS=false to use Gemini embeddings (requires paid plan)
USE_LOCAL_EMBEDDINGS=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Admin Configuration
ADMIN_PASSWORD=your_admin_password_here

# Chroma DB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Logging
LOG_LEVEL=INFO

